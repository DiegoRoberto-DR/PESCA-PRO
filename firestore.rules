rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users Collection (Participant profiles, credentials & moderators)
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // 2. Tournaments Collection (Tournaments, rules & scoring)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Catches Collection (Fishing catch proofs, validations & likes)
    match /catches/{catchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Tournament Codes (Participation verification codes)
    match /tournament_codes/{codeId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Teams Collection (Team rosters & groupings)
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6. Notifications Collection (System alerts, live capture window reminders)
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 7. Support Messages / Help Desk (Direct tickets with administration)
    match /support_messages/{msgId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

  }
}

